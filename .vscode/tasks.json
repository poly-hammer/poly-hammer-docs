    { "label": "Fumadocs: Validate", "type": "shell", "command": "npm run docs:validate", "dependsOn": "Fumadocs: Prepare", "group": "test" },
    { "label": "Fumadocs: Build", "type": "shell", "command": "npm run build", "dependsOn": "Fumadocs: Validate", "group": "build" }
  ]
}
